{
  "name": "where-is-waldo-api",
  "version": "1.0.0",
  "description": "This is the backend api of the Where's Waldo App",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "build": "npx prisma generate && npx tsc",
    "start": "node dist/app.js",
    "dev": "node --watch app.js",
    "prismaGen": "npx prisma generate",
    "prismaMg": "npx prisma migrate dev --name init",
    "startRawSql": "npx prisma generate --sql",
    "watchRawSql": "npx prisma generate --sql --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChoforJr/where-is-waldo-api.git"
  },
  "keywords": [],
  "author": "FORSAKANG CHOFOR JUNIOR",
  "license": "",
  "bugs": {
    "url": "https://github.com/ChoforJr/where-is-waldo-api/issues"
  },
  "homepage": "https://github.com/ChoforJr/where-is-waldo-api#readme",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
